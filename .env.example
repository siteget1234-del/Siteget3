# Environment Variables
# WARNING: VITE_ variables are exposed to the client-side browser.
# Only use this for client-only applications where you understand the security implications.
VITE_GEMINI_API_KEY=

# Firebase Configuration (Required for Admin and Editorial Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
